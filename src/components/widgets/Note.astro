---
import { Icon } from 'astro-icon/components';

export interface Props {
  icon?: string;
  title?: string;
  description?: string;
}

const {
  icon = 'tabler:info-square',
  title = await Astro.slots.render('title'),
  description = await Astro.slots.render('description'),
} = Astro.props;
---

<section class="bg-blue-50 dark:bg-slate-800 not-prose">
  <div class="text-md mx-auto max-w-6xl px-4 py-4 text-center font-medium sm:px-6">
    <Icon name={icon} class="inline-block h-5 w-5 align-text-bottom font-bold" />
    {
      /*
      The icon, title and description are all inline, so they need explicit
      separators. Without them the template ran them straight together and
      rendered "Why Rhema?Built so a...". The spaces are emitted conditionally
      so a note with no title does not gain a stray double space.
    */
    }
    {title && <span class="font-bold" set:html={title} />}
    {title && description && <span> </span>}
    {!title && description && <span> </span>}
    {description && <Fragment set:html={description} />}
  </div>
</section>
